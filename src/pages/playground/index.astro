---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---

<BaseLayout title="Playground — hot cocoa girl" description="Calculators, quizzes, graphs, and other small experiments.">
  <main class="mx-auto w-full max-w-5xl px-4 pb-16 pt-5 sm:px-6 lg:px-8">
    <SiteHeader>
      <div class="mt-10 max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Playground</h1>
      </div>
    </SiteHeader>

    <section class="mt-6" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="sr-only">Interactive tools</h2>
      <a class="playground-card glass group mb-5 block overflow-hidden rounded-3xl border border-amber-100/20 p-6 shadow-xl shadow-slate-950/25 sm:p-9" href="/playground/look-at-the-sun">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="max-w-2xl">
            <p class="text-xs font-medium uppercase tracking-[0.22em] text-amber-100">Sun, sky &amp; ridgelines</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Look At The Sun (SAFELY)</h2>
            <p class="mt-3 max-w-xl text-sm leading-7 text-slate-200 sm:text-base">Watch the Sun rise over the South Bay ridgeline, changing through the year.</p>
          </div>
          <span class="grid size-16 shrink-0 place-items-center rounded-full border border-amber-100/25 bg-amber-100/10 text-3xl text-amber-50 transition group-hover:translate-x-1 group-hover:bg-amber-100/15" aria-hidden="true">☼</span>
        </div>
      </a>
      <a class="playground-card glass group block overflow-hidden rounded-3xl border border-white/15 p-6 shadow-xl shadow-slate-950/25 sm:p-9" href="/playground/lateness-calculator">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="max-w-2xl">
            <p class="text-xs font-medium uppercase tracking-[0.22em] text-pink-200">Dating science*</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">How Late Can She Be?</h2>
            <p class="mt-3 max-w-xl text-sm leading-7 text-slate-200 sm:text-base">Balance her charms against his catch credentials and calculate the only arrival time society needs.</p>
            <p class="mt-3 text-xs text-slate-400">*Science has declined to comment.</p>
          </div>
          <span class="grid size-16 shrink-0 place-items-center rounded-full border border-white/20 bg-white/10 text-3xl text-white transition group-hover:translate-x-1 group-hover:bg-white/15" aria-hidden="true">→</span>
        </div>
      </a>
    </section>
  </main>
</BaseLayout>
