---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="Upcoming Posts — hot cocoa girl" description="Upcoming writing from hot cocoa girl.">
  <main class="mx-auto w-full max-w-3xl px-4 py-5 sm:px-6 lg:px-8">
    <SiteHeader />
    <article class="glass mt-6 rounded-3xl border border-white/15 px-6 py-14 text-center shadow-xl shadow-slate-950/25 sm:px-10 sm:py-20">
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-violet-200">Upcoming Posts</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">Under construction</h1>
      <p class="mx-auto mt-5 max-w-lg text-base leading-8 text-slate-200">More thoughts are on their way. Check back soon ♥</p>
      <ul class="mx-auto mt-9 max-w-xl space-y-3 text-left text-base leading-7 text-slate-100 sm:text-lg">
        <li class="rounded-2xl border border-white/10 bg-slate-950/20 px-4 py-3">Mental health, purpose, high agency</li>
        <li class="rounded-2xl border border-white/10 bg-slate-950/20 px-4 py-3">Steelman manifestation</li>
        <li class="rounded-2xl border border-white/10 bg-slate-950/20 px-4 py-3">Nutrition &amp; the food system</li>
        <li class="rounded-2xl border border-white/10 bg-slate-950/20 px-4 py-3">Happiness — Perfect lifestyle (sleep, beauty, exercise, nutrition &amp; food, friends/family/romance/community)</li>
        <li class="rounded-2xl border border-white/10 bg-slate-950/20 px-4 py-3">Companies that need to exist</li>
        <li class="rounded-2xl border border-white/10 bg-slate-950/20 px-4 py-3">In defence of stated preferences (vs revealed preferences)</li>
        <li class="rounded-2xl border border-white/10 bg-slate-950/20 px-4 py-3">List of insights</li>
      </ul>
    </article>
  </main>
</BaseLayout>
