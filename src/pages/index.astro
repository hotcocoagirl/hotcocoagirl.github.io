---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitorBanner from '../components/VisitorBanner.astro';
import TagBar from '../components/TagBar.astro';
import TagFilter from '../components/TagFilter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="hot cocoa girl — writing" description="Writing about life, beauty, philosophy, and whatever is true today.">
  <main class="mx-auto w-full max-w-5xl px-4 pb-16 pt-5 sm:px-6 lg:px-8">
    <SiteHeader>
      <div class="mt-10 max-w-none">
        <h1 class="whitespace-nowrap text-[clamp(0.62rem,3vw,3rem)] font-bold leading-none tracking-tighter text-white">Splash around in my stream of consciousness</h1>
        <p class="mt-4 max-w-xl text-sm leading-7 text-slate-200 sm:text-base">I seek truth and joy.</p>
      </div>
    </SiteHeader>

    <div class="mx-auto mt-5 max-w-3xl"><VisitorBanner /></div>

    <section class="mt-8" aria-labelledby="writing-heading">
      <h2 id="writing-heading" class="sr-only">Writing</h2>
      <TagBar />
      <div class="mt-5 space-y-3">
        {posts.map((post) => (
          <article data-article-tags={post.data.tags.join('|')} class="article-link glass rounded-2xl border border-white/15 px-5 py-5 shadow-lg shadow-slate-950/20 sm:px-6">
            <time class="text-xs font-medium uppercase tracking-[0.16em] text-slate-300" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
            <a href={`/blog/${post.id}/`} class="block no-underline">
              <h3 class="article-title mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl">{post.data.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-200">{post.data.description}</p>
            </a>
            <TagFilter tags={post.data.tags} />
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
