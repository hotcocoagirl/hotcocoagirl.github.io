---
import '../styles/global.css';
import SkyPanorama from '../components/SkyPanorama.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'hot cocoa girl',
  description = 'Writing on life, love, thought, and beautiful things.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/profile.jpg" />
    <link rel="apple-touch-icon" href="/profile.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div id="cosmic-backdrop-fallback" class="cosmic-backdrop cosmic-backdrop--fallback" aria-hidden="true"></div>
    <SkyPanorama />
    <div class="cosmic-glow" aria-hidden="true"></div>
    <div class="relative z-10"><slot /></div>
    <a class="sky-credit" href="https://www.eso.org/public/images/uhd-9180-panorama-eq-extended/" target="_blank" rel="noreferrer">Sky: Y. Beletsky (LCO)/ESO · CC BY 4.0</a>
    <script is:inline>
      const loadBackdrop = (source, target) => {
        const image = new Image();
        image.decoding = 'async';
        image.src = source;

        const reveal = () => {
          target.style.backgroundImage = `url("${source}")`;
          requestAnimationFrame(() => target.classList.add('is-ready'));
        };

        if ('decode' in image) {
          image.decode().then(reveal).catch(() => image.addEventListener('load', reveal, { once: true }));
        } else {
          image.addEventListener('load', reveal, { once: true });
        }
      };

      loadBackdrop('/milkyway-panorama-fallback.jpg', document.querySelector('#cosmic-backdrop-fallback'));
    </script>
  </body>
</html>
