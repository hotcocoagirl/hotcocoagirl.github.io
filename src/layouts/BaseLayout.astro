---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'hot cocoa girl',
  description = 'Writing on life, love, thought, and beautiful things.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/profile.jpg" />
    <link rel="apple-touch-icon" href="/profile.jpg" />
    <link rel="preload" as="image" href="/crystal-springs-foreground.png" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="night-scene" aria-hidden="true">
      <video
        class="night-sky-video"
        muted
        loop
        playsinline
        preload="auto"
        poster="/milky-way-poster.jpg"
      >
        <source src="/milky-way-pingpong.mp4" type="video/mp4" />
      </video>
      <div class="crystal-springs-foreground"></div>
    </div>
    <div class="cosmic-glow" aria-hidden="true"></div>
    <div class="relative z-10"><slot /></div>
    <p class="sky-credit">
      <a href="https://www.pexels.com/video/stunning-milky-way-time-lapse-in-4k-29434738/" target="_blank" rel="noreferrer">Sky: Luz Calor Som / Pexels</a>
      <span aria-hidden="true"> · </span>
      <a href="https://commons.wikimedia.org/wiki/File:Crystal_Springs_Reservoir01_2014-11-21.jpg" target="_blank" rel="noreferrer">Reservoir: KlausFoehl / CC BY-SA 3.0</a>
    </p>
    <script is:inline>
      const sky = document.querySelector('.night-sky-video');
      if (sky instanceof HTMLVideoElement) {
        const positionKey = 'hcg-sky-position';
        const savedPosition = Number(sessionStorage.getItem(positionKey));
        let restoredPosition = false;

        sky.playbackRate = 0.12;

        const savePosition = () => {
          if (Number.isFinite(sky.currentTime)) {
            sessionStorage.setItem(positionKey, String(sky.currentTime));
          }
        };

        const beginPlayback = () => {
          sky.play().catch(() => undefined);
        };

        sky.addEventListener('loadedmetadata', () => {
          if (Number.isFinite(savedPosition) && savedPosition > 0) {
            sky.currentTime = Math.min(savedPosition, Math.max(0, sky.duration - 0.05));
            restoredPosition = true;
          } else {
            beginPlayback();
          }
        });

        sky.addEventListener('seeked', () => {
          if (restoredPosition) beginPlayback();
        });
        sky.addEventListener('playing', () => sky.classList.add('is-ready'), { once: true });
        sky.addEventListener('timeupdate', savePosition);
        window.addEventListener('pagehide', savePosition);
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') savePosition();
          else beginPlayback();
        });
      }

      const foreground = document.querySelector('.crystal-springs-foreground');
      if (foreground instanceof HTMLElement) {
        const landscape = new Image();
        landscape.decoding = 'sync';
        landscape.src = '/crystal-springs-foreground.png';
        const revealLandscape = () => foreground.classList.add('is-ready');

        if (typeof landscape.decode === 'function') {
          landscape.decode().then(revealLandscape).catch(revealLandscape);
        } else {
          landscape.addEventListener('load', revealLandscape, { once: true });
          landscape.addEventListener('error', revealLandscape, { once: true });
        }
      }
    </script>
  </body>
</html>
