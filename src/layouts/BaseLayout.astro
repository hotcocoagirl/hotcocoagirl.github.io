---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'hot cocoa girl',
  description = 'Writing on life, love, thought, and beautiful things.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/profile.jpg" />
    <link rel="apple-touch-icon" href="/profile.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="cosmic-backdrop" aria-hidden="true"></div>
    <div class="cosmic-glow" aria-hidden="true"></div>
    <div class="relative z-10"><slot /></div>
  </body>
</html>
